# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL 18 connection (separate fields to handle special chars in password)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unimat
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ─── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Qdrant Vector DB ───────────────────────────────────────────────────────────
QDRANT_PATH=./qdrant_data

# ─── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ─── HuggingFace Offline Mode ───────────────────────────────────────────────────
# Set this to 1 to completely disable internet checks when running offline
HF_HUB_OFFLINE=1

# ─── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
